# Copier ce fichier en .env et renseigner les valeurs.
# .env n'est jamais commité : il est dans .gitignore. Ce dépôt est public.

# Adresse du LLM local, API compatible OpenAI. Fournie par Florian
# (responsable). Forme : http://<adresse-du-serveur-llm>:8000/v1
# Après import en production, seule cette valeur change : le LLM y est joint
# par le réseau Docker interne, sous son nom de service.
LLM_BASE_URL=

# Nom exposé par le serveur. Il est stable : il ne change pas quand le modèle
# derrière change.
LLM_MODEL=altoneo-llm

# Vide tant qu'il n'y a pas de passerelle avec une clé par personne.
LLM_API_KEY=

# Révision du modèle servi, fournie par Florian. Obligatoire pour une
# évaluation : un run doit dire sur quel modèle exact il a été obtenu.
LLM_MODEL_REVISION=

# Niveau de journalisation : DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Politique de validation des outils sensibles :
#   refus     - refuse toute action sensible sans rien demander (défaut, et
#               seule valeur admise en évaluation)
#   console   - demande la validation en ligne de commande
APPROBATION=refus

# Documents Word. Les deux se renseignent ensemble, ou restent vides (outils
# Word désactivés). L'agent lit dans DOCUMENTS_ENTREE et écrit ses copies
# modifiées dans DOCUMENTS_SORTIE, un dossier distinct : il n'écrase jamais un
# original. Chemins relatifs au dépôt ; data/ est ignoré par Git.
DOCUMENTS_ENTREE=data/documents/entree
DOCUMENTS_SORTIE=data/documents/sortie

# Docker uniquement : utilisateur du conteneur. Laisser vide en Docker
# rootless (serveur de staging). Avec un Docker classique, mettre la sortie de
# « id -u » et « id -g ». Voir compose.yaml.
AGENT_UID=
AGENT_GID=
